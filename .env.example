# Required — the interviewer brain
ANTHROPIC_API_KEY=sk-ant-...

# Live interview turns. Needs to be fast — the subject is sitting in silence.
ANTHROPIC_MODEL=claude-sonnet-5
# Writing and fact-checking the copy. Nobody is waiting, and this is what the
# client reads, so spend the thinking here. Defaults to ANTHROPIC_MODEL.
ANTHROPIC_EDITOR_MODEL=claude-opus-5

# Optional — voice. Without it the browser's built-in voice is used (works, sounds robotic).
# Bounty: "Best Use of ElevenLabs" (wireless earbuds)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Spanish interviews use this voice. Pick a native Latin American Spanish voice
# from the ElevenLabs library — an English voice reading Spanish gives itself
# away in one sentence. Falls back to the voice above if left empty.
ELEVENLABS_VOICE_ID_ES=

# Voice tuning. Defaults are set for a conversational read, not an audiobook.
# Model: eleven_multilingual_v2 sounds more human; eleven_turbo_v2_5 is faster and flatter.
ELEVENLABS_MODEL=eleven_multilingual_v2
# Lower stability = more natural variation. Below 0.25 it starts to wobble.
ELEVENLABS_STABILITY=0.3
ELEVENLABS_STYLE=0.55
ELEVENLABS_SIMILARITY=0.75

# Where the app is reachable. Used to build the interview link you hand a vendor.
PUBLIC_BASE_URL=http://localhost:8787
PORT=8787

# Optional summary email. Use a Resend API key and a verified sender address.
# These values are read only by the server. Leave blank to show the unavailable state.
RESEND_API_KEY=
EMAIL_FROM=
